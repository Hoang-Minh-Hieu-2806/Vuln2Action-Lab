# Copy this file to `.env` and fill in values locally. NEVER commit `.env` to Git.
# Only needed for optional LLM/API-based generation. The rule-based baseline works without any key.

# Which generation provider to use by default: rule_based | llm | t5
GENERATOR_PROVIDER=rule_based

# Optional: remote LLM API settings (OpenAI-compatible or similar)
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# Optional: local lab settings
LAB_NETWORK=vuln2action-lab-net
LOG_LEVEL=INFO
